{
  "name": "tui-driver",
  "version": "0.1.0",
  "private": true,
  "description": "Drive, see and snapshot any TUI through tmux — built so coding agents can open a terminal UI, look at it and navigate it.",
  "license": "MIT",
  "author": "Evandro Bezerra Filho",
  "type": "module",
  "homepage": "https://github.com/evandrocabf/tui-driver#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evandrocabf/tui-driver.git"
  },
  "bugs": {
    "url": "https://github.com/evandrocabf/tui-driver/issues"
  },
  "keywords": [
    "tui",
    "terminal",
    "tmux",
    "cli",
    "testing",
    "e2e",
    "screenshot",
    "automation",
    "ai-agent",
    "snapshot-testing"
  ],
  "engines": {
    "bun": ">=1.3.11"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "bin": {
    "tui": "./bin/tui.ts",
    "tui-driver": "./bin/tui.ts"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "examples",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "tui": "bun run bin/tui.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test tests --timeout 120000",
    "test:unit": "bun test tests/unit --timeout 60000",
    "test:integration": "bun test tests/integration --timeout 120000",
    "test:coverage": "bun test tests --coverage --timeout 120000 && bun run scripts/check-coverage.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0"
  }
}
